# Adresses publiques, injectées dans le paquet du navigateur à la construction.
#
# Versionnées volontairement : préfixées « NEXT_PUBLIC_ », elles se retrouvent
# de toute façon en clair dans le code servi au visiteur — ce ne sont pas des
# secrets. Les inscrire ici garantit qu'une construction réussit même si la
# variable manque côté hébergeur, ce qui produirait autrement un site pointant
# vers localhost.
NEXT_PUBLIC_API_URL=https://nokendeclicbackend-production.up.railway.app
# Le domaine apex redirige vers www : c'est cette forme qui doit figurer
# dans les liens canoniques et les aperçus de partage.
NEXT_PUBLIC_SITE_URL=https://www.noken.app
