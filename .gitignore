# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
#
# `.env.production` fait exception et reste versionné : il ne contient que des
# adresses préfixées NEXT_PUBLIC_, qui finissent de toute façon en clair dans le
# paquet servi au navigateur. Les inscrire au dépôt évite un déploiement qui
# pointerait vers localhost faute de variable côté hébergeur.
.env
.env.local
.env.*.local
.env.development
.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
